{
  "name": "railtime",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "pnpm --filter @railtime/web dev",
    "build": "pnpm --filter @railtime/web build",
    "type-check": "tsc --noEmit -p packages/core && tsc --noEmit -p packages/schema && tsc --noEmit -p packages/network && tsc --noEmit -p packages/renderer && tsc --noEmit -p packages/data && tsc --noEmit -p packages/tooling && tsc --noEmit -p packages/video && pnpm --filter @railtime/web type-check",
    "test-unit": "vitest",
    "test-unit-ci": "vitest run",
    "eslint-check": "eslint --max-warnings 0",
    "eslint-fix": "eslint --fix",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "code-quality:dead-code": "knip",
    "data:boundary": "pnpm --filter @railtime/data boundary",
    "data:summaries": "pnpm --filter @railtime/data summaries",
    "data:previews": "pnpm --filter @railtime/data previews",
    "video:record": "pnpm --filter @railtime/video record",
    "test-unit-coverage": "vitest run --coverage",
    "test-bench": "pnpm --filter @railtime/data test-bench",
    "test-mutation": "node packages/tooling/src/cli.mutation.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-jsdoc": "^65.4.5",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "79.0.0",
    "eslint-plugin-vue": "~10.12.0",
    "eslint-plugin-vuejs-accessibility": "2.6.3",
    "globals": "^17.14.0",
    "knip": "^6.44.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2"
  }
}
