{
  "name": "railtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @railtime/web dev",
    "build": "pnpm --filter @railtime/web build",
    "type-check": "tsc --noEmit -p packages/schema && tsc --noEmit -p packages/renderer && tsc --noEmit -p scripts && tsc --noEmit -p data && pnpm --filter @railtime/web type-check",
    "test-unit": "vitest",
    "test-unit-ci": "vitest run",
    "eslint-check": "eslint",
    "eslint-fix": "eslint --fix",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "code-quality:dead-code": "knip",
    "data:format": "node scripts/cli.formatCity.ts",
    "test-unit-coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@railtime/schema": "workspace:*",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-vue": "~10.12.0",
    "globals": "^17.13.0",
    "knip": "^6.42.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1"
  }
}
