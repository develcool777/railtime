  "plans": {
    "long-term-strategy-2010": {
      "name": "Subway Long Term Strategy (2007–2010)",
      "status": "proposed",
      "description": "SPT's 2007–2010 scoping study for the Subway's future: an East End circle through St Mungo's, Onslow, Duke Street, Celtic Park, Dalmarnock, Newhall and Gorbals (promoted for the 2014 Commonwealth Games at about £2.3bn), a branch to Cathcart over the Cathcart Circle, and an Exhibition Centre–Maryhill line in old rail tunnels. Shelved as too costly; bus rapid transit was preferred.",
