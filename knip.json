{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["vitest.shared.ts"],
      "project": ["vitest.*.ts"]
    },
    "packages/data": {
      "entry": ["src/*/cli.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/schema": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/network": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/renderer": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "web": {
      "entry": ["src/pages/**/*.vue", "test/**/*.test.ts"],
      "project": ["src/**/*.{ts,vue,css}", "test/**/*.ts"],
      "ignoreDependencies": ["@iconify-json/lucide", "vue-tsc"]
    },
    "packages/tooling": {
      "entry": ["src/cli.*.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  }
}
