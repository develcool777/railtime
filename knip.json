{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/cli.*.ts", "scripts/test/**/*.test.ts", "data/test/**/*.test.ts", "vitest.shared.ts"],
      "project": ["scripts/**/*.ts", "data/test/**/*.ts", "vitest.*.ts"]
    },
    "packages/schema": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/renderer": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "web": {
      "entry": ["app/pages/**/*.vue", "test/**/*.test.ts"],
      "project": ["app/**/*.{ts,vue,css}", "test/**/*.ts"],
      "ignoreDependencies": ["@iconify-json/lucide", "vue-tsc"]
    }
  }
}
