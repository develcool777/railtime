node_modules/
dist
.nuxt/
.output/
.data/
.DS_Store
*.log
# A coverage report left at the root; the tools write theirs under test-reports/. Not any folder called coverage: the app has one.
/coverage/
# Local, but the mutation score history, which is shared.
test-reports/*
!test-reports/mutation-scores.json
# Each benchmark's last run, on this machine (`pnpm test-bench`).
packages/*/test-reports/
.stryker-tmp/
# The videos recorded (`pnpm video:record`): uploaded, not kept here; and the browser profile it
# records in, which caches the map's tiles.
packages/video/videos/
packages/video/.cache/
# What Wrangler keeps as it runs.
.wrangler/
